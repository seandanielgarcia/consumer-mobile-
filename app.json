{
  "expo": {
    "name": "yardsale",
    "slug": "garage-sale",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.garagesale.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Pick photos of things to sell.",
        "NSCameraUsageDescription": "Take photos of things to sell.",
        "NSLocationWhenInUseUsageDescription": "Show yardsales near you."
      }
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-image",
      "expo-font",
      "expo-asset",
      [
        "expo-contacts",
        {
          "contactsPermission": "Save Keiki to your contacts."
        }
      ]
    ],
    "scheme": "garagesale",
    "platforms": [
      "ios"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F3F2FA"
    }
  }
}
